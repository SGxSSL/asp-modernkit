  "sql_dialect": {
    "content.asp": [
      "\"\n       \n        Select Case objPost.UrlType\n            Case \""
    ],
    "slickcms/category.asp": [
      "\"Select Count(*) From dbo.Categories\""
    ],
    "slickcms/comment.asp": [
      "\"Select [Title],[URL] = CASE [Pageable] When 1 Then Replace(convert(varchar, [DateCreated], 111), '/', '-') + '/' + [URL] Else [URL] End From dbo.Posts Where PostID = \"",
      "\"Select COUNT(*) As [Total] From [Comments] Where [PostID] = \"",
      "\"Select Count(*) From dbo.Comments\""
    ],
    "slickcms/image.asp": [
      "\"Select Name, Alt, Title, Orientation From Images Where Album = '\""
    ],
    "slickcms/link.asp": [
      "\"Select Count(*) From dbo.Links\""
    ],
    "slickcms/post.asp": [
      "\"\n\n\t\t\tSelect Case m_UrlType\n                Case \"",
      "\"Select Count(*) From dbo.Posts\""
    ],
    "slickcms/relationship.asp": [
      "\"Select CategoryID, Name From dbo.Categories Order By Name Asc\"",
      "\"Select Count(*) From dbo.Relationships\"",
      "\"Select TagID, Name From dbo.Tags Order By Name Asc\"",
      "\"Select LinkID, Name From dbo.Links Order By Name Asc\"",
      "\"Select PostID, Title From dbo.Posts Order By Title Asc\"",
      "\"Select UserID, Name From dbo.Users Order By Name Asc\""
    ],
    "slickcms/slickcms.asp": [
      "\"Select [Email] From dbo.Users Where [Active] = 1\""
    ],
    "slickcms/tag.asp": [
      "\"Select Count(*) From dbo.Tags\""
    ],
    "slickcms/user.asp": [
      "\"Select Count(*) From dbo.Users\"",
      "\"Select [UserID], [Name] From dbo.Users Where [Active] = 1 Order By [Name] Asc\""
    ]
  },
